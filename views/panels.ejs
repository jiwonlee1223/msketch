<div class="msketch-panel" id="msketch_panel">
    <%- include("panel_move") -%>
    <%- include("panel_plane") -%>
    <%- include("panel_motor") -%>
    <%- include("panel_pattern") -%>
    <%- include("panel_analysis") -%>
    <%- include("panel_opt") -%>
    <%- include("panel_gen") -%>
    <%- include("panel_fab") -%>
    <%- include("panel_load") -%>
    <%- include("settings") -%>

    <div id="panel_close_btn"><i class="material-icons">close</i></div>
</div>

<script>
    $('#panel_close_btn').click(function(){
    	$('#msketch_panel').removeClass('expand');
        removePanelActiveClass();
    });

    $('#btn_panel_pattern').click(function(){
        removePanelActiveClass();
        $('#btn_panel_pattern').addClass('active');
        $('#msketch_panel').addClass('expand');
        $('#panel_pattern').show();
        getPlaneInfoToPlanePanel();
    });

    $('#btn_panel_gen').click(function(){
        removePanelActiveClass();
        $('#btn_panel_gen').addClass('active');
        $('#msketch_panel').addClass('expand');
        $('#panel_gen').show();
        getPlaneInfoToPlanePanel();
    });

    $('#btn_panel_link3d').click(function(){
        removePanelActiveClass();
        $('#btn_panel_link3d').addClass('active');
        $('#msketch_panel').addClass('expand');
        $('#panel_fab_link').show();
        getPlaneInfoToPlanePanel();

        if(!isPlaying) interfaceSelect(TOOL_STACK);
    });

    $('#btn_panel_gear').click(function(){
        removePanelActiveClass();
        $('#btn_panel_gear').addClass('active');
        $('#msketch_panel').addClass('expand');
        $('#panel_fab_gear').show();
        getPlaneInfoToPlanePanel();
    });

    $('#btn_settings').click(function(){
        removePanelActiveClass();
        $('#btn_settings').addClass('active');
        $('#msketch_panel').addClass('expand');
        $('#panel_settings').show();
        getPlaneInfoToPlanePanel();

        loadSettings();
    });

    // opened by the Select tool (plane -> view settings, link -> part settings)
    function showSettingsPanel(_panelId){
        removePanelActiveClass();
        $('#msketch_panel').addClass('expand');
        $('#' + _panelId).show();

        loadSettings();
    }

    // opened by the Select tool when a motor is clicked
    function showMotorPanel(_actuator){
        removePanelActiveClass();
        $('#msketch_panel').addClass('expand');
        $('#panel_motor').show();
        getPlaneInfoToPlanePanel();

        updateMotorList();
        var _name = _actuator.getName() + " on Plane" + findCurrentAssemblyNum();
        $('#motor_list option').filter(function(){ return $(this).text() == _name; }).prop('selected', true);
        updateMotorInfo();
    }

    function removePanelActiveClass(){
        // leaving the 3D Link panel ends link picking for stacking
        if(toolState==TOOL_STACK) interfaceSelect(TOOL_STACK);
        setStackTarget(null);

        $('.msketch-panel-open').removeClass('active');
        $('#msketch_panel').children().hide();
        $('#panel_close_btn').show();
    };
</script>
